# Account used to deploy EvidenceLog.sol. This account becomes the contract's
# immutable owner and is the ONLY account able to call logEvidence(), so
# backend/.env PRIVATE_KEY must be set to this same key.
#
# For a local `npx hardhat node`, Account #0's key is printed at startup:
#   0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
DEPLOYER_PRIVATE_KEY=

# Optional. Only needed to deploy to the Polygon Amoy testnet (chainId 80002).
# Defaults to https://polygon-amoy-bor-rpc.publicnode.com. The endpoint Polygon
# used to publish, rpc-amoy.polygon.technology, no longer resolves. Public
# endpoints are rate-limited; set your own (Alchemy/Infura) if deploys stall.
POLYGON_AMOY_RPC_URL=

# Amoy uses its OWN key and does not fall back to DEPLOYER_PRIVATE_KEY above,
# which for local work is Hardhat's deterministic account #0 - a key everyone
# has. The deployer becomes the contract's immutable owner and the only account
# that can ever call logEvidence(), with no transfer function, so deploying
# publicly with a shared key would let anyone write evidence to it permanently.
#
# Use a funded throwaway key. Never put a key holding real funds in this file.
AMOY_DEPLOYER_PRIVATE_KEY=

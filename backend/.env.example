PORT=5000
DATABASE_PATH=./database/evidence.db
HARDHAT_NETWORK_URL=http://127.0.0.1:8545
CORS_ORIGIN=http://localhost:5173

# From the `hardhat ignition deploy` output.
CONTRACT_ADDRESS=

# MUST be the same account that deployed the contract. logEvidence() is
# onlyOwner and the owner is fixed at deployment to whoever DEPLOYER_PRIVATE_KEY
# (root .env) signed with. If these differ, every POST /api/record reverts and
# the record is marked `failed` in SQLite, with the reason only in the log.
#
# For a local `npx hardhat node`, Account #0's key is printed at startup:
#   0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
PRIVATE_KEY=
